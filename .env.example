# Example environment file for the Aegis Maritime System deployment
# ---------------------------------------------------------------
# GitHub Owner (used for GHCR image names)
GH_OWNER=your-github-username

# MongoDB credentials (used by the backend container)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-please

# JWT secret for the backend API (must be strong)
JWT_SECRET=super-secret-key

# Public URL for the socket.io connections (used by the frontend)
PUBLIC_SOCKET_URL=https://yourdomain.com

# Optional – set this if you want the frontend to know its own URL
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com
