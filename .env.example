# Example environment file for the Aegis Maritime System deployment
# ---------------------------------------------------------------
# GitHub Owner (used for GHCR image names)
GH_OWNER=your-github-username

# MongoDB credentials (used by the backend container)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-please

# The MongoDB connection string used by the backend API.
# Replace user/password/host with your actual MongoDB.
MONGO_URI=mongodb://admin:change-me-please@localhost:27017/aegis

# JWT secret for the backend API (must be a strong random value).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=__CHANGE_ME_RANDOM_64_BYTES__

# Public URL for the socket.io connections (used by the frontend)
PUBLIC_SOCKET_URL=https://yourdomain.com

# CORS origin(s) the backend will accept. Comma-separated for multiple.
# Leave FRONTEND_URL unset (or set to false) in production to forbid cross-origin.
FRONTEND_URL=https://yourdomain.com

# Operator credentials for the /api/auth/login endpoint.
# Defaults are admin / admin123 for demo; rotate both before deployment.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
