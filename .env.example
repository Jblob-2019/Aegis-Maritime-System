# GitHub Container Registry owner (used by docker-compose to pull images)
GH_OWNER=pranesdev

# Full MongoDB Atlas connection string.
# Replace <DB_PASSWORD> with the real password you set in Atlas for
# user jana9380355915_db_user.
MONGO_URI=mongodb+srv://jana9380355915_db_user:<DB_PASSWORD>@aegis-maritime-system.hl1i0u7.mongodb.net/?appName=Aegis-Maritime-System

# JWT secret used by the backend to sign authentication tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=<paste-your-64-char-hex-here>

# Public URL the frontend uses to reach Socket.IO (your domain)
PUBLIC_SOCKET_URL=https://yourdomain.com

# Optional – public URL of the frontend
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com