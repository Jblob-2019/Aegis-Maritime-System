# GitHub Container Registry owner (used by docker-compose to pull images)
GH_OWNER=pranesdev

# Full MongoDB Atlas connection string.
# Replace <DB_PASSWORD> with the real password you set in Atlas for
# user jana9380355915_db_user.
MONGO_URI=mongodb+srv://jana9380355915_db_user:<DB_PASSWORD>@aegis-maritime-system.hl1i0u7.mongodb.net/?appName=Aegis-Maritime-System

# JWT secret used by the backend to sign authentication tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 32
JWT_SECRET=<paste-your-64-char-hex-here>

# Hardware API Key required by ESP32 devices to post data to the backend.
# Generate one similarly to the JWT_SECRET.
HARDWARE_API_KEY=<paste-your-64-char-hex-here>

# --------------------------------------------------------------------------
# Optional overrides (everything below has sensible defaults)
# --------------------------------------------------------------------------

# Override the auto-detected LAN IP. Leave EMPTY for normal use:
# inject-env.sh on the frontend container will detect the host's primary
# IPv4 automatically. Set this only if your Ubuntu server has multiple
# NICs (Docker bridge, VPN, etc.) and the wrong one is picked.
# HOST_LAN_IP=

# Public URL the frontend uses to reach Socket.IO. Leave EMPTY to use
# the same value as the auto-detected backend (recommended for LAN deploys).
# Set this only if the dashboard and backend are on different hosts or
# you're behind a reverse proxy / TLS terminator.
# PUBLIC_SOCKET_URL=

# Optional: public URL of the frontend (used for documentation / links only)
# NEXT_PUBLIC_FRONTEND_URL=

# Optional: lock CORS to a specific allow-list. Comma-separated origins.
# If EMPTY, the backend reflects any request Origin (fine for a single-host
# LAN deploy). Set this for a public-internet deploy.
# ALLOWED_ORIGINS=https://your.domain,https://other.domain
